TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
MINI_APP_URL=https://example.com/app

# Webhook mode (production only — Render, etc). Leave both empty for local dev:
# the bot then runs as a separate polling process via `python -m app.bot.main`.
# WEBHOOK_BASE_URL=https://your-backend.onrender.com
# TELEGRAM_WEBHOOK_SECRET=some-random-string

# Vercel sets this automatically as the Authorization bearer token for Cron Job
# requests to /api/cron/notifications — set the same value here so the endpoint
# can verify it. Not needed for local dev.
# CRON_SECRET=some-random-string

# Локальная разработка (по умолчанию, ничего не нужно настраивать):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Продакшен (Supabase Postgres) — раскомментировать и заполнить при деплое:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
REDIS_URL=redis://localhost:6379/0

OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FAL_API_KEY=
OPENAI_API_KEY=

TRIBUTE_WEBHOOK_SECRET=

CORS_ORIGINS=["http://localhost:5173"]
